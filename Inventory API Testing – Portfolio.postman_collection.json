  "item": [
    {
      "name": "Get Delivery Order Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response is successful\", function () {\r",
              "    const response = pm.response.json();\r",
              "\r",
              "    pm.expect(response.isSuccess).to.eql(true);\r",
              "    pm.expect(response.statusCode).to.eql(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Delivery order statuses are returned\", function () {\r",
              "    const response = pm.response.json();\r",
              "\r",
              "    pm.expect(response.data).to.be.an(\"array\");\r",
              "    pm.expect(response.data.length).to.be.greaterThan(0);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bearerToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Storeid",
            "value": "",
            "type": "text"
          },
          {
            "key": "Sxsrf",
            "value": "{{Sxsrf}}",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/inventory/api/v1/CommonDropdown/GetDeliveryOrderStatusDropdown/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "api",
            "v1",
            "CommonDropdown",
            "GetDeliveryOrderStatusDropdown",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Order By DO Code",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Guard: only run if response is successful",
              "if (pm.response.code !== 200) {",
              "    console.error(\"Request failed with status:\", pm.response.code, pm.response.text());",
              "    pm.test(\"Response status is 200\", function () {",
              "        pm.response.to.have.status(200);",
              "    });",
              "    return;",
              "}",
              "",
              "let res = pm.response.json();",
              "",
              "// Guard: ensure res.data exists",
              "if (!res.data) {",
              "    console.error(\"Response does not contain 'data':\", JSON.stringify(res));",
              "    pm.test(\"Response contains data\", function () {",
              "        pm.expect(res.data).to.not.be.undefined;",
              "    });",
              "    return;",
              "}",
              "",
              "let order = res.data;",
              "",
              "// Guard: ensure deliveryOrderDetails exists and is non-empty",
              "if (!order.deliveryOrderDetails || order.deliveryOrderDetails.length === 0) {",
              "    console.error(\"deliveryOrderDetails is missing or empty\");",
              "    pm.test(\"deliveryOrderDetails exists and is non-empty\", function () {",
              "        pm.expect(order.deliveryOrderDetails).to.be.an(\"array\").that.is.not.empty;",
              "    });",
              "    return;",
              "}",
              "",
              "let detail = order.deliveryOrderDetails[0];",
              "",
              "// Guard: ensure productBatches exists and is non-empty",
              "if (!detail.productBatches || detail.productBatches.length === 0) {",
              "    console.error(\"productBatches is missing or empty\");",
              "    pm.test(\"productBatches exists and is non-empty\", function () {",
              "        pm.expect(detail.productBatches).to.be.an(\"array\").that.is.not.empty;",
              "    });",
              "    return;",
              "}",
              "",
              "let batch = detail.productBatches[0];",
              "",
              "// Delivery Order",
              "pm.collectionVariables.set(\"doId\", order.id);",
              "pm.collectionVariables.set(\"doCode\", order.doCode);",
              "",
              "// Product Details",
              "pm.collectionVariables.set(\"doDetailId\", detail.id);",
              "pm.collectionVariables.set(\"productId\", detail.productId);",
              "pm.collectionVariables.set(\"productVariantId\", detail.productVariantId);",
              "pm.collectionVariables.set(\"unitOfMeasurementId\", detail.unitOfMeasurementId);",
              "",
              "// Package Information",
              "pm.collectionVariables.set(\"packageWeightInKg\", detail.packageWeightInKg);",
              "pm.collectionVariables.set(\"packageHeightInCm\", detail.packageHeightInCm);",
              "pm.collectionVariables.set(\"packageWidthInCm\", detail.packageWidthInCm);",
              "pm.collectionVariables.set(\"packageLengthInCm\", detail.packageLengthInCm);",
              "",
              "// Batch Information",
              "pm.collectionVariables.set(\"warehouseMappingId\", batch.WarehouseMappingId);",
              "pm.collectionVariables.set(\"batchId\", batch.BatchId);",
              "pm.collectionVariables.set(\"productStackId\", batch.StockStackId);",
              "pm.collectionVariables.set(\"productStackBatchDetailsId\", batch.StockStackBatchDetailsId);",
              "pm.collectionVariables.set(\"stackQuantity\", batch.StackQuantity);",
              "pm.collectionVariables.set(\"uin\", batch.UIN);",
              "",
              "// Optional: Print values in Postman Console",
              "console.log(\"Variables Saved Successfully\");",
              "console.log({",
              "    doCode: order.doCode,",
              "    doId: order.id,",
              "    doDetailId: detail.id,",
              "    productId: detail.productId,",
              "    productVariantId: detail.productVariantId,",
              "    unitOfMeasurementId: detail.unitOfMeasurementId,",
              "    warehouseMappingId: batch.WarehouseMappingId,",
              "    batchId: batch.BatchId,",
              "    productStackId: batch.StockStackId,",
              "    productStackBatchDetailsId: batch.StockStackBatchDetailsId,",
              "    stackQuantity: batch.StackQuantity,",
              "    uin: batch.UIN",
              "});",
              "",
              "pm.test(\"Variables set successfully\", function () {",
              "    pm.expect(order.id).to.not.be.undefined;",
              "    pm.expect(detail.id).to.not.be.undefined;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Storeid",
            "value": "",
            "type": "text"
          },
          {
            "key": "Sxsrf",
            "value": "{{Sxsrf}}",
