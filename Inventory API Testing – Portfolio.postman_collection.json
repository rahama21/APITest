          "mode": "raw",
          "raw": "[\r\n  {\r\n    \"doCode\": \"{{doCode}}\",\r\n    \"doId\": {{doId}},\r\n    \"packagingDate\": \"{{$isoTimestamp}}\",\r\n    \"packagingStaffId\": 114,\r\n    \"orderPackagingDetails\": [\r\n      {\r\n        \"doDetailId\": {{doDetailId}},\r\n        \"productId\": {{productId}},\r\n        \"productVariantId\": {{productVariantId}},\r\n        \"unitOfMeasurementId\": {{unitOfMeasurementId}},\r\n        \"quantity\": 1,\r\n        \"packageWeightInKg\": {{packageWeightInKg}},\r\n        \"packageHeightInCm\": {{packageHeightInCm}},\r\n        \"packageWidthInCm\": {{packageWidthInCm}},\r\n        \"packageLengthInCm\": {{packageLengthInCm}},\r\n        \"orderPackagingBatchDetails\": [\r\n          {\r\n            \"warehouseMappingId\": {{warehouseMappingId}},\r\n            \"batchId\": {{batchId}},\r\n            \"quantity\": 1,\r\n            \"hasSerialNo\": false,\r\n            \"orderPackagingSerialNumbers\": null,\r\n           \"StackQuantity\": {{stackQuantity}},\r\n            \"productStackId\": {{productStackId}},\r\n            \"productStackBatchDetailsId\": {{productStackBatchDetailsId}},\r\n            \"uin\": \"{{uin}}\"\r\n          }\r\n        ]\r\n      }\r\n    ],\r\n    \"orderPackagingMaterials\": [\r\n      {\r\n        \"packagingMaterialId\": {{packagingMaterialId}},\r\n        \"quantity\": 1,\r\n        \"unitPrice\": {{unitPrice}},\r\n        \"remarks\": \"\",\r\n        \"uom\": \"{{uom}}\"\r\n      }\r\n    ]\r\n  }\r\n]",
